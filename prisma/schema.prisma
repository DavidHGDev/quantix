// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoDocumento {
  CC
  NIT
  PP
}

enum Role {
  ADMIN
  VENDEDOR
  TESTER
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
}

enum EstadoOrden {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

model User {
  id            Int           @id @default(autoincrement())
  firstName     String
  lastName      String?
  tipoDocumento TipoDocumento
  documento     String
  email         String        @unique
  password      String
  role          Role          @default(VENDEDOR)
  isActive      Boolean       @default(true)
  invoices      Invoice[]
  ordenesCompra Order[]
}

//Factura
model Invoice {
  id           Int        @id @default(autoincrement())
  fecha        DateTime
  usuario      User       @relation(fields: [usuarioId], references: [id])
  usuarioId    Int
  cliente      Client     @relation(fields: [clienteId], references: [id])
  clienteId    Int
  metodoDePago MetodoPago
  totalPagar   Float
}

model DetallaVenta {
  id             Int     @id @default(autoincrement())
  //factura        Invoice @relation(fields: [facturaId], references: [id])
  facturaId      Int
  producto       Product @relation(fields: [productoId], references: [id])
  productoId     Int
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
}

model Client {
  id            Int           @id @default(autoincrement())
  firstName     String
  lastName      String?
  tipoDocumento TipoDocumento
  documento     String
  email         String?
  phone         String?
  address       String?
  isActive      Boolean       @default(true)
  invoices      Invoice[]
}

model Categoria {
  id            Int       @id @default(autoincrement())
  nameCategorie String
  description   String?
  productos     Product[]
}

model Product {
  id           Int        @id @default(autoincrement())
  codigoBarras String @unique
  nameProduct  String
  stock        Int        @default(0)
  priceVenta   Decimal    @db.Decimal(10, 2)
  isActive     Boolean    @default(true)
  categoria    Categoria  @relation(fields: [categoriaId], references: [id])
  categoriaId  Int
  suppliers    Supplier[]
  detallesCompra OrderDetail[]
  detallesVenta  DetallaVenta[]
}

//Tabla de proveedor
model Supplier {
  id            Int           @id @default(autoincrement())
  tipoDocumento TipoDocumento
  documento     String  @unique
  razonSocial   String
  phone         String
  email         String
  products      Product[]
  ordenesCompra Order[]
}

//ordenes de compra
model Order {
  id          Int           @id @default(autoincrement())
  fecha       DateTime      @default(now())
  proveedor   Supplier      @relation(fields: [proveedorId], references: [id])
  proveedorId Int
  estado      EstadoOrden   @default(PENDIENTE)
  usuario     User          @relation(fields: [userId], references: [id])
  userId      Int
  detalles    OrderDetail[]
}

model OrderDetail {
  id          Int     @id @default(autoincrement())
  orden       Order   @relation(fields: [ordenId], references: [id])
  ordenId     Int
  producto    Product @relation(fields: [productoId], references: [id])
  productoId  Int
  cantidad    Int
  priceCompra Decimal @db.Decimal(10,2)
}
