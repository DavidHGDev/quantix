// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoDocumento {
  CC
  NIT
  PP
}

enum Role {
  ADMIN
  VENDEDOR
  TESTER
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  CREDITO
}

enum EstadoCredito {
  PENDIENTE
  PAGADO
  ANULADO
}

enum EstadoOrden {
  PENDIENTE
  RECIBIDA
  CANCELADA
}

model User {
  id            Int           @id @default(autoincrement())
  firstName     String
  lastName      String?
  tipoDocumento TipoDocumento
  documento     String
  email         String        @unique
  password      String
  role          Role          @default(VENDEDOR)
  isActive      Boolean       @default(true)
  invoices      Invoice[]
  ordenesCompra Order[]
  abonos        Payment[]
}

//Factura
model Invoice {
  id           Int        @id @default(autoincrement())
  fecha        DateTime       @default(now())
  usuario      User       @relation(fields: [usuarioId], references: [id])
  usuarioId    Int
  cliente      Client     @relation(fields: [clienteId], references: [id])
  clienteId    Int
  metodoDePago MetodoPago
  totalPagar   Decimal        @db.Decimal(12, 2)
  credito      Credit?
  detalles     DetallaVenta[]
}

// Detalle de la Venta
model DetallaVenta {
  id             Int      @id @default(autoincrement())
  factura        Invoice  @relation(fields: [facturaId], references: [id])
  facturaId      Int
  producto       Product  @relation(fields: [productoId], references: [id])
  productoId     Int
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(12, 2)
}

model Client {
  id            Int           @id @default(autoincrement())
  firstName     String
  lastName      String?
  tipoDocumento TipoDocumento
  documento     String
  email         String?
  phone         String?
  address       String?
  isActive      Boolean       @default(true)
  invoices      Invoice[]
  creditos      Credit[]
}

model Categoria {
  id            Int       @id @default(autoincrement())
  nameCategorie String
  description   String?
  productos     Product[]
}

model Product {
  id           Int        @id @default(autoincrement())
  codigoBarras String @unique
  nameProduct  String
  stock        Int        @default(0)
  priceVenta   Decimal    @db.Decimal(10, 2)
  isActive     Boolean    @default(true)
  categoria    Categoria  @relation(fields: [categoriaId], references: [id])
  categoriaId  Int
  suppliers    Supplier[]
  detallesCompra OrderDetail[]
  detallesVenta  DetallaVenta[]
}

//Tabla de proveedor
model Supplier {
  id            Int           @id @default(autoincrement())
  tipoDocumento TipoDocumento
  documento     String  @unique
  razonSocial   String
  phone         String
  email         String
  products      Product[]
  isActive      Boolean @default(true)
  ordenesCompra Order[]
}

//ordenes de compra
model Order {
  id          Int           @id @default(autoincrement())
  fecha       DateTime      @default(now())
  proveedor   Supplier      @relation(fields: [proveedorId], references: [id])
  proveedorId Int
  estado      EstadoOrden   @default(PENDIENTE)
  usuario     User          @relation(fields: [userId], references: [id])
  userId      Int
  detalles    OrderDetail[]
}

model OrderDetail {
  id          Int     @id @default(autoincrement())
  orden       Order   @relation(fields: [ordenId], references: [id])
  ordenId     Int
  producto    Product @relation(fields: [productoId], references: [id])
  productoId  Int
  cantidad    Int
  priceCompra Decimal @db.Decimal(10,2)
}

// Cuenta por cobrar (Crédito)
model Credit {
  id            Int           @id @default(autoincrement())
  cliente       Client        @relation(fields: [clienteId], references: [id])
  clienteId     Int
  factura       Invoice       @relation(fields: [facturaId], references: [id])
  facturaId     Int           @unique // Una factura solo tiene una cuenta de crédito
  montoOriginal Decimal       @db.Decimal(12, 2)
  saldoCredito  Decimal       @db.Decimal(12, 2)
  estado        EstadoCredito @default(PENDIENTE)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  abonos        Payment[]
}

// Abonos / Pagos parciales
model Payment {
  id           Int        @id @default(autoincrement())
  credito      Credit     @relation(fields: [creditoId], references: [id])
  creditoId    Int
  montoAbono   Decimal    @db.Decimal(12, 2)
  metodoPago   MetodoPago // EFECTIVO o TRANSFERENCIA
  nota         String?
  usuario      User       @relation(fields: [usuarioId], references: [id])
  usuarioId    Int
  createdAt    DateTime   @default(now())
}