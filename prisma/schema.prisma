// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoDocumento {
  CC
  NIT
  PP
}

enum Role {
  ADMIN
  VENDEDOR
  TESTER
}

model User {
  id            Int           @id @default(autoincrement())
  firstName     String
  lastName      String?
  tipoDocumento TipoDocumento
  documento     String
  email         String        @unique
  password      String
  role          Role          @default(VENDEDOR)
  isActive      Boolean       @default(true)
}

model Categoria {
  id            Int       @id @default(autoincrement())
  nameCategorie String
  description   String?
  productos     Product[]
}

model Product {
  id           Int        @id @default(autoincrement())
  codigoBarras String
  nameProduct  String
  stock        Int        @default(0)
  priceVenta   Decimal    @db.Decimal(10, 2)
  isActive     Boolean    @default(true)
  categoria    Categoria  @relation(fields: [categoriaId], references: [id])
  categoriaId  Int
  suppliers    Supplier[]
}

//Tabla de proveedor
model Supplier {
  id            Int           @id @default(autoincrement())
  tipoDocumento TipoDocumento
  documento     String
  razonSocial   String
  phone         String
  email         String
  products      Product[]
}
