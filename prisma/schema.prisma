// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoDocumento {
  CC
  NIT
  PP
}

enum Role {
  ADMIN
  VENDEDOR
  TESTER
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
}

model User {
  id            Int           @id @default(autoincrement())
  firstName     String
  lastName      String?
  tipoDocumento TipoDocumento
  documento     String
  email         String        @unique
  password      String
  role          Role          @default(VENDEDOR)
  isActive      Boolean       @default(true)
  invoices      Invoice[]
}

//Factura
model Invoice {
  id           Int        @id @default(autoincrement())
  fecha        DateTime
  usuario      User       @relation(fields: [usuarioId], references: [id])
  usuarioId    Int
  cliente      Client     @relation(fields: [clienteId], references: [id])
  clienteId    Int
  metodoDePago MetodoPago
  totalPagar   Float
}

model DetallaVenta {
  id             Int     @id @default(autoincrement())
  facturaId      Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal
}

model Client {
  id            Int           @id @default(autoincrement())
  firstName     String
  lastName      String?
  tipoDocumento TipoDocumento
  documento     String
  email         String?
  phone         String?
  address       String?
  isActive      Boolean       @default(true)
  invoices      Invoice[]
}

model Categoria {
  id            Int       @id @default(autoincrement())
  nameCategorie String
  description   String?
  productos     Product[]
}

model Product {
  id           Int        @id @default(autoincrement())
  codigoBarras String
  nameProduct  String
  stock        Int        @default(0)
  priceVenta   Decimal    @db.Decimal(10, 2)
  isActive     Boolean    @default(true)
  categoria    Categoria  @relation(fields: [categoriaId], references: [id])
  categoriaId  Int
  suppliers    Supplier[]
}

//Tabla de proveedor
model Supplier {
  id            Int           @id @default(autoincrement())
  tipoDocumento TipoDocumento
  documento     String
  razonSocial   String
  phone         String
  email         String
  products      Product[]
}
